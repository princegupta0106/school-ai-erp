EXPO_PUBLIC_API_URL=https://school-ai-erp.onrender.com

# ---- Where the AI service (ai-server/) runs. Needed when the backend is NOT on the same PC as the AI (e.g. both on Render). ----
# Leave it out on your own PC (it uses http://127.0.0.1:8001).
AI_URL=https://school-ai-erp-ogqz.onrender.com

# ---- Lets run.bat push everything in /db to Supabase for you (no more pasting into the SQL editor). ----
# Supabase -> Project Settings -> Database -> Connection string -> URI (use "Session pooler" if you get a connection error).
# OPTIONAL - not needed if you do the one-time server/scripts/bootstrap.sql paste (then SUPABASE_URL + SUPABASE_SECRET_KEY are enough).
SUPABASE_DB_URL=
